# Development: backend that the Vite proxy forwards /api/v1 to. Defaults to a local FastAPI
# server (http://localhost:8000). Point it elsewhere only deliberately.
VITE_BACKEND_PROXY_TARGET="http://localhost:8000"

# Production builds (set in Vercel): API root including /api/v1. When unset, builds keep using
# the current Heroku backend.
VITE_API_BASE_URL="https://counting-down-fastapi-c061e3e79aa6.herokuapp.com/api/v1"
